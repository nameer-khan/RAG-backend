					"name": "Update Document",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Updated Machine Learning Basics\",\n  \"content\": \"Updated content about machine learning...\",\n  \"category\": \"updated_technology\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/documents/{{document_id}}/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"documents",
								"{{document_id}}",
								""
							]
						}
					}
				},
				{
					"name": "Delete Document",
					"request": {
						"method": "DELETE",
						"header": [
							{
