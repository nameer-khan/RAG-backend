								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"sender\": \"user\",\n  \"content\": \"Hello, how are you?\",\n  \"context\": {},\n  \"metadata\": {}\n}"
