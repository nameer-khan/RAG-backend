						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"What is machine learning?\",\n  \"document_category\": \"technology\",\n  \"conversation_history\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Tell me about AI\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"AI is...\"\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/rag/query/",
