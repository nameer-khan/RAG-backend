					"name": "Get Document",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/documents/{{document_id}}/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"documents",
								"{{document_id}}",
								""
							]
						}
					}
				},
